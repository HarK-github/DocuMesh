# Database & Storage
DATABASE_URL=sqlite:///./data/app.db
DB_PATH=./data/app.db
UPLOAD_DIR=./uploads

# Embedding Service & Vector Store
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBED_BATCH_SIZE=32
SIMILARITY_THRESHOLD=0.35
SUGGESTION_COUNT=5
CANDIDATE_POOL_SIZE=30
NEG_WEIGHT=0.5
MMR_LAMBDA=0.7
MAX_PENDING_PER_SEED=10

# LLM Service (for suggested relations & document chat)
# Provider options: fake, openai, huggingface
LLM_PROVIDER=fake
# For OpenAI: LLM_MODEL=gpt-4o-mini, LLM_API_KEY=sk-...
# For Hugging Face Serverless: LLM_MODEL=meta-llama/Llama-3.2-1B-Instruct, HF_TOKEN=hf_...
LLM_MODEL=meta-llama/Llama-3.2-1B-Instruct
LLM_API_KEY=
HF_TOKEN=
LLM_MAX_CONCURRENCY=3
LLM_TIMEOUT_SECONDS=30.0
MAX_RELATION_PAIRS=10
MIN_RELATION_COS_SIM=0.25
AUTO_HIGHLIGHT_BATCH_SIZE=20
AUTO_HIGHLIGHT_MAX_PAIRS=100
AUTO_HIGHLIGHT_PROTO_THRESHOLD=0.18

# Graph-Aware Document Chat
CHAT_TOP_K_SENTENCES=5
CHAT_TOP_K_ANNOTATIONS=5
CHAT_NEIGHBOR_HOPS=2
CHAT_MAX_HISTORY=5
CHAT_MAX_CONTEXT_CHARS=3000

# Server & Concurrency
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_WORKERS=4
SQLITE_BUSY_TIMEOUT_MS=5000
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=50

# Frontend environment variables
VITE_API_URL=http://localhost:8000
